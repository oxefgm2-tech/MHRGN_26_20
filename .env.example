# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Central server API base URL when running frontend decoupled on Windows/Mobile
# Example: https://api.mehregan-vet.ir or http://194.5.200.15:3000
VITE_API_BASE_URL=

# Server runtime configuration
PORT=3000
NODE_ENV=development
# Optional absolute path for persistent application data.
# DATA_DIR=./data

# DATABASE_PROVIDER: Set to 'json' (default) for built-in file storage without external database.
# Set to 'postgres' only when connecting to a real PostgreSQL database server.
# مقدار پیش‌فرض: json (نیازی به تنظیم دیتابیس خارجی نیست)
DATABASE_PROVIDER=json

# DATABASE_URL: Only needed if DATABASE_PROVIDER=postgres.
# Leave empty for default JSON storage mode.
# اگر از سرور PostgreSQL خارجی استفاده نمی‌کنید، این مقدار را خالی بگذارید.
# Example: postgresql://postgres:password@localhost:5432/mehregan_clinic
DATABASE_URL=
