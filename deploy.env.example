# ====================================================================
# تنظیمات محیطی دیپلوی بر روی سرور اوبونتو ۲۲.۰۴ (Ubuntu 22.04 LTS)
# ====================================================================
# این فایل را به نام deploy.env کپی کرده و اطلاعات سرور خود را در آن وارد کنید:

# ۱. اطلاعات اتصال به سرور لینوکس (LinuxServer یا VPS)
SERVER_IP=192.168.137.22
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=YourStrongPasswordHere

# ۲. مسیر نصب پروژه روی سرور اوبونتو
REMOTE_APP_DIR=/var/www/vetclinic

# ۳. تنظیمات پورت و دامنه برنامه
APP_PORT=3000
DOMAIN_OR_IP=your-clinic-domain.com

# ۴. کلیدهای امنیتی و هوش مصنوعی
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=production
DATA_DIR=/var/www/vetclinic/data
DATABASE_URL=postgresql://vetclinic_user:change_this_password@127.0.0.1:5432/mehregan_vet
DATABASE_PROVIDER=postgres

# ۵. نشانی سرور متمرکز API برای کلاینت‌های دسکتاپ ویندوز و موبایل
VITE_API_BASE_URL=http://your-vps-ip:3000
