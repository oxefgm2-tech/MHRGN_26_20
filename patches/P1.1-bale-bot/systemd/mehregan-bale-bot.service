[Unit]
Description=Mehregan Vet Clinic - Bale Messenger Bot (Balethon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=svc-clinic
Group=svc-clinic
WorkingDirectory=/opt/mehregan-bale-bot
EnvironmentFile=/etc/mehregan/bale_bot.env
ExecStart=/opt/mehregan-bale-bot/venv/bin/python /opt/mehregan-bale-bot/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
