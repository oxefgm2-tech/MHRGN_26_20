+            if (stat.isFile()) {
+              const isSaved = (store.radiographyCases || []).some((c: any) => c.fileName === fname);
+              files.push({
+                id: `rad-${fname}`,
+                name: fname,
+                size: (stat.size / (1024 * 1024)).toFixed(2) + ' MB',
+                sizeBytes: stat.size,
+                date: new Date(stat.mtime).toLocaleDateString('fa-IR') + ' ' + new Date(stat.mtime).toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' }),
+                saved: isSaved,
+                path: fpath,
