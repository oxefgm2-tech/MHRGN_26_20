# Fill this file (deploy.env) and keep it out of version control when it contains secrets.
# For initial forced run we provide non-sensitive placeholder values that will allow an automated deploy attempt.

# SSH / Target VPS
SSH_HOST=203.0.113.12
SSH_USER=vpsuser
# Either use SSH_KEY_PATH (safer) OR SSH_PASS (sshpass). Prefer key.
SSH_KEY_PATH=
SSH_PASS=vps-password-placeholder

# Remote deployment path
REMOTE_DIR=/opt/vet-clinic

# App / Node
NODE_VERSION=20
NPM_COMMAND=start
ENVIRONMENT=production

# Service name for systemd
SERVICE_NAME=vet-clinic
